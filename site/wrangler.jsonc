// Cloudflare deploy config for the Forge402 website (static files only, no Worker code).
// Build first with the live API addresses, then from this folder: npx wrangler deploy
//   VITE_API_BASE=https://api.forge402.pro VITE_SCAN_BASE=https://scan.forge402.pro VITE_CF_PAID_PLAN=0 npx vite build
// Deep links (/docs, /scan/0x...) fall back to index.html; the React router draws the page.
// Address: https://forge402-site.reinkeep.workers.dev and https://forge402.pro (custom domain).
{
  "name": "forge402-site",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "forge402.pro", "custom_domain": true },
    { "pattern": "www.forge402.pro", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
